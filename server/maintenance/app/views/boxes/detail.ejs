<!-- Box-level GPS capture (inspector/admin) -->
<% if (user.role === 'admin' || user.role === 'inspector') { %>
<script>
(function(){
  function captureAndSave(btn) {
    if (!navigator.geolocation) { alert('المتصفح لا يدعم تحديد الموقع.'); return; }
    var orig = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> جارٍ التحديد…';
    var statusEl = document.getElementById('loc-status');
    navigator.geolocation.getCurrentPosition(function(pos){
      fetch('/boxes/<%= box.id %>/location', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ lat: pos.coords.latitude, lng: pos.coords.longitude })
      })
      .then(function(r){ return r.json(); })
      .then(function(d){
        if (d.ok) { location.reload(); }
        else { btn.disabled = false; btn.innerHTML = orig; statusEl.textContent = d.msg || 'خطأ.'; }
      })
      .catch(function(){ btn.disabled = false; btn.innerHTML = orig; statusEl.textContent = 'فشل الاتصال.'; });
    }, function(){
      btn.disabled = false; btn.innerHTML = orig;
      alert('لم يتم السماح بالوصول للموقع. يرجى السماح من إعدادات المتصفح.');
    }, { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 });
  }
  var s = document.getElementById('save-loc-btn');
  var u = document.getElementById('update-loc-btn');
  if (s) s.addEventListener('click', function(){ captureAndSave(this); });
  if (u) u.addEventListener('click', function(){ captureAndSave(this); });
})();
</script>
<% } %>

<!-- Attach GPS to photos that were uploaded without coordinates -->
<script>
(function(){
  document.querySelectorAll('.add-loc-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var pid = this.dataset.pid;
      var self = this;
      if (!navigator.geolocation) { alert('المتصفح لا يدعم تحديد الموقع.'); return; }
      self.disabled = true;
      self.innerHTML = '<span class="spinner-border spinner-border-sm"></span> جارٍ التحديد…';
      navigator.geolocation.getCurrentPosition(function(pos){
        var lat = pos.coords.latitude, lng = pos.coords.longitude;
        fetch('/boxes/photos/' + pid + '/location', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ lat: lat, lng: lng })
        })
        .then(function(r){ return r.json(); })
        .then(function(d){
          if (d.ok) {
            var a = document.createElement('a');
            a.href = 'https://maps.google.com/?q=' + d.lat + ',' + d.lng;
            a.target = '_blank';
            a.className = 'btn btn-outline-danger btn-sm py-0 px-1 mt-1 w-100';
            a.innerHTML = '<i class="bi bi-geo-alt-fill"></i> تتبع';
            self.parentNode.replaceChild(a, self);
          } else {
            self.disabled = false;
            self.innerHTML = '<i class="bi bi-geo-alt"></i> إضافة موقع';
          }
        })
        .catch(function(){
          self.disabled = false;
          self.innerHTML = '<i class="bi bi-geo-alt"></i> إضافة موقع';
        });
      }, function(){
        self.disabled = false;
        self.innerHTML = '<i class="bi bi-geo-alt"></i> إضافة موقع';
        alert('لم يتم السماح بالوصول للموقع. يرجى السماح من إعدادات المتصفح.');
      }, { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 });
    });
  });
})();
</script>

