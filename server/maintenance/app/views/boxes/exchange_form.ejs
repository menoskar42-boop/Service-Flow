<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card">
      <div class="card-header"><h5 class="mb-0"><%= title %></h5></div>
      <div class="card-body">
        <% if (errors.length) { %><div class="alert alert-danger"><% errors.forEach(e => { %><div><%= e %></div><% }) %></div><% } %>
        <form method="post" action="/boxes/exchanges/create">
          <div class="mb-3">
            <label class="form-label fw-semibold">اسم السنترال</label>
            <input type="text" name="name" class="form-control" value="<%= exchange ? exchange.name : '' %>" required autofocus>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
            <a href="/boxes/exchanges" class="btn btn-outline-secondary">إلغاء</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
