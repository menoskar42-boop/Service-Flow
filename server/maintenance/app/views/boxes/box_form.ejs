<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card">
      <div class="card-header"><h5 class="mb-0"><%= title %></h5></div>
      <div class="card-body">
        <% if (errors.length) { %><div class="alert alert-danger"><% errors.forEach(e => { %><div><%= e %></div><% }) %></div><% } %>
        <p class="text-muted">السنترال: <strong><%= cabinet.exchange_name %></strong> | الكابينة: <strong><%= cabinet.number %></strong></p>
        <form method="post" action="/boxes/cabinets/<%= cabinet.id %>/create">
          <div class="mb-3">
            <label class="form-label fw-semibold">رقم البوكس</label>
            <input type="text" name="number" class="form-control" placeholder="مثال: 101" required autofocus value="<%= typeof inputNumber !== 'undefined' ? inputNumber : '' %>">
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> إضافة</button>
            <a href="/boxes/exchanges/<%= cabinet.exchange_id %>/cabinets" class="btn btn-outline-secondary">إلغاء</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
