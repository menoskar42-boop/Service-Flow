<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0"><i class="bi bi-diagram-3 me-2"></i><%= title %></h4>
  <% if (user.role === 'admin') { %>
  <a href="/boxes/exchanges/create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> إضافة سنترال</a>
  <% } %>
</div>
<div class="row g-3">
  <% exchanges.forEach(ex => { %>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title"><i class="bi bi-building me-1 text-primary"></i><%= ex.name %></h5>
        <p class="mb-1 text-muted"><i class="bi bi-grid me-1"></i> <%= ex.cabinet_count %> كابينة</p>
        <p class="mb-3 text-muted"><i class="bi bi-box2 me-1"></i> <%= ex.box_count %> بوكس</p>
        <div class="d-flex gap-2">
          <a href="/boxes/exchanges/<%= ex.id %>/cabinets" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-grid"></i> الكباين
          </a>
          <% if (user.role === 'admin') { %>
          <form method="post" action="/boxes/exchanges/<%= ex.id %>/delete">
            <button class="btn btn-outline-danger btn-sm" onclick="return confirm('حذف هذا السنترال وكل ما يحتويه؟')">
              <i class="bi bi-trash"></i>
            </button>
          </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <% }) %>
  <% if (!exchanges.length) { %>
  <div class="col-12"><div class="alert alert-info">لا توجد سنترالات. أضف سنتراً أو <a href="/admin/import">استورد بيانات من Excel</a>.</div></div>
  <% } %>
</div>
<%- include('../partials/footer') %>
