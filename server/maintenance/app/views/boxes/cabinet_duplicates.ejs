<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0 fw-bold"><i class="bi bi-diagram-2 me-1"></i><%= title %></h5>
  <a href="/boxes/exchanges" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-right"></i> السنترالات</a>
</div>

<div class="alert alert-info small">
  الكابينة المكتوبة بشرطة مايلة (<span class="n">2/1</span>) والمكتوبة بشرطة عادية
  (<span class="n">2-1</span>) <strong>كابينة واحدة</strong>. الصفحة دى بتلمّ المكرّر وتدمجه.
  <br>
  <strong>الأصلية</strong> = اللى فيها بوكسات أكتر. كل بوكس فى المكرّرة بيروح للأصلية،
  ولو فيه بوكس بنفس الرقم هناك فالفحوصات والصور بتتنقل للبوكس الموجود والمكرّر يتمسح —
  <strong>مفيش أى بيانات بتضيع</strong>.
</div>

<% if (!groups.length) { %>
<div class="text-center text-muted py-5">
  <i class="bi bi-check2-circle fs-1 d-block mb-2 text-success opacity-75"></i>
  مفيش كباين مكرّرة. تمام.
</div>
<% } else { %>
<div class="table-responsive">
  <table class="table table-sm align-middle">
    <thead class="table-light">
      <tr>
        <th>السنترال</th>
        <th>الكابينة الأصلية (هتفضل)</th>
        <th>المكرّرة (هتتشال)</th>
      </tr>
    </thead>
    <tbody>
      <% groups.forEach(g => { %>
      <tr>
        <td><%= g.exchangeName %></td>
        <td>
          <span class="badge bg-success">كابينة <span class="n"><%= g.keep.number %></span></span>
          <span class="text-muted small"><%= g.keep.box_count %> بوكس</span>
        </td>
        <td>
          <% g.drop.forEach(d => { %>
          <span class="badge bg-danger me-1">كابينة <span class="n"><%= d.number %></span></span>
          <span class="text-muted small me-2"><%= d.box_count %> بوكس</span>
          <% }) %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<form method="post" action="/boxes/cabinets/duplicates/merge"
      onsubmit="return confirm('دمج <%= groups.length %> مجموعة كباين مكرّرة؟ العملية مش قابلة للتراجع.');">
  <button class="btn btn-danger">
    <i class="bi bi-diagram-2 me-1"></i> دمج المكرّر (<%= groups.length %> مجموعة)
  </button>
</form>
<% } %>
<%- include('../partials/footer') %>
