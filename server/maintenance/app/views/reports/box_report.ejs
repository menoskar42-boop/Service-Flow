<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Cairo', sans-serif; background: #fff; font-size: 14px; }
    .report-header { border-bottom: 3px solid #0d6efd; padding-bottom: 1rem; margin-bottom: 1.5rem; }
    .section-title { background: #f0f4ff; border-right: 4px solid #0d6efd; padding: .4rem .8rem; font-weight: 700; margin: 1.2rem 0 .6rem; border-radius: 0 .25rem .25rem 0; }
    .photo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; margin-top: .5rem; }
    .photo-grid img { width: 100%; height: 160px; object-fit: cover; border-radius: .25rem; border: 1px solid #dee2e6; }
    .photo-item { break-inside: avoid; }
    .print-btn { position: fixed; bottom: 1.5rem; left: 1.5rem; z-index: 999; }
    table { font-size: 13px; }
    @media print {
      .print-btn, .no-print { display: none !important; }
      body { font-size: 12px; }
      .photo-grid { grid-template-columns: repeat(2, 1fr); break-inside: avoid; }
      .photo-grid img { height: auto !important; max-height: none !important; object-fit: contain !important; max-width: 100%; }
      .section-title { background: #e8f0fe !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .table-danger { background-color: #fde8e8 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .table-success { background-color: #e8f5e9 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
  </style>
</head>
<body class="p-3 p-md-4">

  <!-- Print button -->
  <div class="print-btn no-print">
    <button onclick="window.print()" class="btn btn-primary shadow">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="me-1" viewBox="0 0 16 16">
        <path d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z"/>
        <path d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2H5zm4 11v-1H7v1H5v-2h6v2h-2zm1-4v-1H6v1H5V8h6v1h-1zm0-4V3H6v1H5V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1h-1z"/>
      </svg>
      طباعة / حفظ PDF
    </button>
    <a href="/boxes/<%= box.id %>" class="btn btn-outline-secondary ms-2">العودة</a>
  </div>

  <!-- Report header -->
  <div class="report-header d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
      <h4 class="fw-bold mb-1">تقرير بوكس — <%= box.number %></h4>
      <div class="text-muted">
        السنترال: <strong><%= box.exchange_name %></strong> |
        الكابينة: <strong><%= box.cabinet_number %></strong>
      </div>
    </div>
    <div class="text-end">
      <div>
        <%
          const statusLabels = {
            pending_inspection: 'بانتظار الفحص', inspected: 'تم الفحص',
            needs_maintenance: 'يحتاج صيانة', in_progress: 'قيد الصيانة', completed: 'مكتمل'
          };
          const statusColors = {
            pending_inspection: 'secondary', inspected: 'info', needs_maintenance: 'warning',
            in_progress: 'warning', completed: 'success'
          };
        %>
        <span class="badge bg-<%= statusColors[box.status] || 'secondary' %> fs-6">
          <%= statusLabels[box.status] || box.status %>
        </span>
      </div>
      <div class="text-muted small mt-1">تاريخ الطباعة: <%= new Date().toLocaleDateString('ar-EG') %></div>
    </div>
  </div>

  <% if (!inspection) { %>
  <div class="alert alert-warning">لم يتم فحص هذا البوكس بعد.</div>
  <% } else { %>

  <!-- Inspection info -->
  <div class="section-title">معلومات الفحص</div>
  <table class="table table-sm table-bordered mb-0">
    <tr><th width="30%">المراقب</th><td><%= inspection.inspector_name %></td><th width="20%">التاريخ</th><td><%= new Date(inspection.date).toISOString().split('T')[0] %></td></tr>
    <% if (inspection.general_notes) { %>
    <tr><th>ملاحظات عامة</th><td colspan="3"><%= inspection.general_notes %></td></tr>
    <% } %>
  </table>

  <!-- Checklist -->
  <div class="section-title">نتائج قائمة الفحص</div>
  <table class="table table-sm table-bordered mb-0">
    <thead class="table-light"><tr><th>البند</th><th>الحالة</th><th>الإصلاح</th><th>ملاحظات</th></tr></thead>
    <tbody>
    <% Object.entries(CHECKLIST_LABELS).forEach(([key, label]) => {
        const item = items.find(i => i.item_key === key);
        if (!item) return;
        const isBad = item.value === 'bad' || item.value === 'yes';
        const fixSt = itemStatusMap[key];
        const isDone = fixSt && fixSt.is_done;
    %>
    <tr class="<%= isDone ? 'table-success' : (isBad ? 'table-danger' : '') %>">
      <td><strong><%= label %></strong></td>
      <td>
        <% if (item.value === 'good') { %>جيد
        <% } else if (item.value === 'bad') { %>سيء
        <% } else if (item.value === 'yes') { %>يوجد
        <% } else { %>لا يوجد<% } %>
      </td>
      <td>
        <% if (isBad) { %>
          <%= isDone ? '✓ تم الإصلاح' : '⏳ قيد الصيانة' %>
        <% } else { %>—<% } %>
      </td>
      <td class="text-muted"><%= item.notes || '—' %></td>
    </tr>
    <% }) %>
    </tbody>
  </table>

  <!-- Maintenance info -->
  <% if (task) { %>
  <div class="section-title">معلومات الصيانة</div>
  <table class="table table-sm table-bordered mb-0">
    <tr>
      <th width="25%">الفني</th><td><%= task.tech_name || '—' %></td>
      <th width="25%">حالة المهمة</th>
      <td><%= task.status === 'completed' ? 'مكتملة' : task.status === 'in_progress' ? 'قيد التنفيذ' : 'بانتظار البدء' %></td>
    </tr>
    <% if (task.started_at) { %><tr><th>بدأ في</th><td><%= new Date(task.started_at).toISOString().split('T')[0] %></td><th>اكتمل في</th><td><%= task.completed_at ? new Date(task.completed_at).toISOString().split('T')[0] : '—' %></td></tr><% } %>
    <% if (task.notes) { %><tr><th>ملاحظات الفني</th><td colspan="3"><%= task.notes %></td></tr><% } %>
  </table>
  <% } %>

  <!-- Before Photos -->
  <% if (beforePhotos.length) { %>
  <div class="section-title">صور قبل الصيانة (<%= beforePhotos.length %>)</div>
  <div class="photo-grid">
    <% beforePhotos.forEach(p => { %>
    <div class="photo-item"><img src="/uploads/<%= p.filename %>" alt="قبل الصيانة"></div>
    <% }) %>
  </div>
  <% } %>

  <!-- After Photos -->
  <% if (afterPhotos.length) { %>
  <div class="section-title">صور بعد الصيانة (<%= afterPhotos.length %>)</div>
  <div class="photo-grid">
    <% afterPhotos.forEach(p => { %>
    <div class="photo-item"><img src="/uploads/<%= p.filename %>" alt="بعد الصيانة"></div>
    <% }) %>
  </div>
  <% } %>

  <% } %>

  <div class="text-center text-muted small mt-4 no-print">
    نظام صيانة البوكسات الذكي — Smart Box Maintenance System
  </div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
