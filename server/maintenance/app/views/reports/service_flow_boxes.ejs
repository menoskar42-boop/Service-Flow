<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h4 class="mb-0"><i class="bi bi-link-45deg me-2 text-info"></i><%= title %></h4>
  <div class="d-flex gap-2">
    <button onclick="location.reload()" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-clockwise"></i> تحديث</button>
    <a href="/reports" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-right"></i> التقارير</a>
  </div>
</div>

<!-- Search bar -->
<form method="get" class="card card-body mb-3 py-2">
  <div class="row g-2 align-items-end">
    <div class="col-md-6">
      <label class="form-label small mb-1">بحث</label>
      <input type="text" name="q" class="form-control form-control-sm" placeholder="ابحث في النتائج..." value="<%= query.q || '' %>">
    </div>
    <div class="col-md-auto">
      <button class="btn btn-primary btn-sm me-1"><i class="bi bi-search"></i> بحث</button>
      <a href="/reports/service-flow" class="btn btn-outline-secondary btn-sm">إعادة</a>
    </div>
    <% if (!error && rows.length) { %>
    <div class="col-md-3 text-muted small pt-2">
      النتائج: <strong><%= rows.length %></strong>
      <% if (totalPages > 1) { %> | صفحة <%= currentPage %> / <%= totalPages %><% } %>
    </div>
    <% } %>
  </div>
</form>

<% if (error) { %>
<div class="alert alert-danger">
  <i class="bi bi-exclamation-triangle-fill me-2"></i>
  <strong>تعذّر الاتصال بـ service-flow:</strong> <%= error %>
  <div class="small mt-2 text-muted">
    تأكد من:
    <ol class="mb-0 mt-1">
      <li>إضافة <code>SF_API_TOKEN</code> في <strong>Replit Secrets</strong> لمشروع maintenance</li>
      <li>أن مشروع <strong>service-flow</strong> شغّال على Replit (اضغط Run أو Publish)</li>
    </ol>
  </div>
</div>
<% } else if (!rows.length) { %>
<div class="alert alert-info"><i class="bi bi-info-circle me-1"></i>لا توجد بيانات.</div>
<% } else { %>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-bordered table-sm table-hover mb-0 sf-table">
        <thead class="text-center">
          <tr>
            <% columns.forEach(col => { %>
            <th class="align-middle" style="white-space:nowrap;font-size:0.82rem"><%= col %></th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
        <% rows.forEach(row => { %>
        <tr>
          <% columns.forEach(col => { %>
          <td class="small" style="white-space:nowrap"><%= row[col] !== null && row[col] !== undefined ? row[col] : '—' %></td>
          <% }) %>
        </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if (totalPages > 1) { %>
<nav class="mt-3">
  <ul class="pagination pagination-sm justify-content-center flex-wrap">
    <% for (let p = 1; p <= totalPages; p++) { %>
    <li class="page-item <%= p === currentPage ? 'active' : '' %>">
      <a class="page-link" href="/reports/service-flow?<%= new URLSearchParams({...query, page: p}).toString() %>"><%= p %></a>
    </li>
    <% } %>
  </ul>
</nav>
<% } %>

<% } %>

<style>
.sf-table thead tr th {
  position: sticky;
  top: 0;
  z-index: 2;
  background-color: #212529;
  color: #fff;
}
</style>
<%- include('../partials/footer') %>
