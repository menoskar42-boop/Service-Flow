<!-- Recent inspections -->
<div class="card">
  <div class="card-header fw-semibold">آخر الفحوصات</div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table mb-0">
        <thead><tr><th>السنترال</th><th>الكابينة</th><th>البوكس</th><th>المراقب</th><th>التاريخ</th></tr></thead>
        <tbody>
          <% recentInspections.forEach(i => { %>
          <tr>
            <td><%= i.exchange_name %></td>
            <td><%= i.cabinet_number %></td>
            <td><a href="/boxes/<%= i.box_id %>"><%= i.box_number %></a></td>
            <td><%= i.inspector_name %></td>
            <td><%= new Date(i.date).toISOString().split('T')[0] %></td>
          </tr>
          <% }) %>
          <% if (!recentInspections.length) { %><tr><td colspan="5" class="text-center text-muted py-3">لا توجد فحوصات.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
