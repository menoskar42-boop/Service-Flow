<%- include('../partials/header') %>
<h4 class="mb-4"><i class="bi bi-bar-chart me-2"></i><%= title %></h4>

<!-- Stat cards -->
<div class="row g-3 mb-4">
  <% const cards = [
    { key: 'pending_inspection', label: 'بانتظار الفحص',  cls: 'secondary', icon: 'clock' },
    { key: 'inspected',          label: 'تم الفحص',        cls: 'info',      icon: 'clipboard-check' },
    { key: 'needs_maintenance',  label: 'يحتاج صيانة',    cls: 'warning',   icon: 'exclamation-triangle' },
    { key: 'in_progress',        label: 'قيد الصيانة',     cls: 'warning',   icon: 'tools' },
    { key: 'completed',          label: 'مكتمل',           cls: 'success',   icon: 'check-circle' },
  ]; %>
  <% cards.forEach(c => { %>
  <div class="col-6 col-md-2">
    <div class="card text-center py-3">
      <i class="bi bi-<%= c.icon %> text-<%= c.cls %> fs-3 mb-1"></i>
      <div class="fs-2 fw-bold"><%= counts[c.key] || 0 %></div>
      <div class="small text-muted"><%= c.label %></div>
    </div>
  </div>
  <% }) %>
  <div class="col-6 col-md-2">
    <div class="card text-center py-3">
      <i class="bi bi-box2 text-primary fs-3 mb-1"></i>
      <div class="fs-2 fw-bold text-primary"><%= totalBoxes %></div>
      <div class="small text-muted">إجمالي البوكسات</div>
    </div>
  </div>
</div>

<!-- Quick links -->
<div class="row g-3 mb-4">
  <div class="col-md-3">
    <a href="/reports/inspected" class="card text-decoration-none hover-card">
      <div class="card-body text-center py-4">
        <i class="bi bi-clipboard-check fs-2 text-info"></i>
        <div class="fw-semibold mt-2">البوكسات التي تم فحصها</div>
      </div>
    </a>
  </div>
  <div class="col-md-3">
    <a href="/reports/issues" class="card text-decoration-none hover-card">
      <div class="card-body text-center py-4">
        <i class="bi bi-exclamation-triangle fs-2 text-warning"></i>
        <div class="fw-semibold mt-2">البوكسات التي بها ملاحظات</div>
      </div>
    </a>
  </div>
  <div class="col-md-3">
    <a href="/reports/maintenance" class="card text-decoration-none hover-card">
