<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h4 class="mb-0">
    <i class="bi bi-exclamation-triangle me-2 text-danger"></i><%= title %>
  </h4>
  <div class="d-flex gap-2">
    <a href="/reports/missing-boxes/export" class="btn btn-success btn-sm">
      <i class="bi bi-file-earmark-excel"></i> Excel
    </a>
    <a href="/reports" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-right"></i> التقارير
    </a>
  </div>
</div>

<!-- Summary -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="card text-center py-3 border-danger">
      <i class="bi bi-box-seam text-danger fs-4 mb-1"></i>
      <div class="fs-3 fw-bold text-danger"><%= totalMissing %></div>
      <div class="small text-muted">إجمالي البكسيات الناقصة</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card text-center py-3 border-warning">
      <i class="bi bi-grid-3x3-gap text-warning fs-4 mb-1"></i>
      <div class="fs-3 fw-bold text-warning"><%= cabinets.length %></div>
      <div class="small text-muted">كباين بها فجوات</div>
    </div>
  </div>
</div>

<% if (!cabinets.length) { %>
<div class="alert alert-success">
  <i class="bi bi-check-circle me-1"></i> لا توجد بكسيات ناقصة — جميع الكباين مكتملة التسلسل.
</div>
<% } else { %>
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-dark">
          <tr>
            <th>#</th>
            <th>السنترال</th>
            <th>الكابينة</th>
            <th>أعلى رقم</th>
            <th>عدد الناقص</th>
            <th>أرقام البكسيات الناقصة</th>
          </tr>
        </thead>
        <tbody>
          <% cabinets.forEach(function(cab, idx){ %>
          <tr>
            <td class="text-muted"><%= idx + 1 %></td>
            <td><%= cab.exchange_name %></td>
            <td><%= cab.cabinet_number %></td>
            <td><span class="badge bg-secondary"><%= cab.max_num %></span></td>
            <td><span class="badge bg-danger"><%= cab.missing.length %></span></td>
            <td>
              <% cab.missing.forEach(function(n){ %>
              <span class="badge bg-warning text-dark me-1 mb-1"><%= n %></span>
              <% }); %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% } %>
<%- include('../partials/footer') %>
