<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Cairo', sans-serif; background: #fff; font-size: 13px; }
    .n { direction: ltr; unicode-bidi: embed; display: inline-block; }
    .report-header { border-bottom: 3px solid #0d6efd; padding-bottom: .8rem; margin-bottom: 1.2rem; }
    .box-section { border: 1px solid #dee2e6; border-radius: .4rem; margin-bottom: 1.5rem; page-break-inside: avoid; }
    .box-section-header { background: #e8f0fe; border-bottom: 2px solid #0d6efd; padding: .5rem .8rem; border-radius: .4rem .4rem 0 0; font-weight: 700; }
    .section-title { background: #f0f4ff; border-right: 4px solid #0d6efd; padding: .3rem .7rem; font-weight: 700; margin: .8rem 0 .4rem; border-radius: 0 .25rem .25rem 0; }
    .photo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .4rem; margin-top: .4rem; }
    .photo-grid img { width: 100%; height: 180px; object-fit: contain; background: #f8f9fa; border-radius: .25rem; border: 1px solid #dee2e6; }
    .photo-item { break-inside: avoid; }
    .print-btn { position: fixed; bottom: 1.5rem; left: 1.5rem; z-index: 999; }
    table { font-size: 12px; }
    @media print {
      .print-btn, .no-print { display: none !important; }
      body { font-size: 11px; }
      .box-section { page-break-inside: avoid; }
      .photo-grid { grid-template-columns: repeat(2, 1fr); break-inside: avoid; }
      .photo-grid img { height: auto !important; max-height: 180px !important; object-fit: contain !important; max-width: 100%; }
      .section-title { background: #e8f0fe !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .box-section-header { background: #e8f0fe !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .table-danger { background-color: #fde8e8 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .table-success { background-color: #e8f5e9 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
  </style>
</head>
<body class="p-3 p-md-4">

<div class="print-btn no-print">
  <button onclick="window.print()" class="btn btn-primary shadow">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="me-1" viewBox="0 0 16 16">
      <path d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z"/>
      <path d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2H5zm4 11v-1H7v1H5v-2h6v2h-2zm1-4v-1H6v1H5V8h6v1h-1zm0-4V3H6v1H5V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1h-1z"/>
    </svg>
    طباعة / حفظ PDF
  </button>
  <a href="/reports/cabinet/<%= cabinet.id %>/photos/download" class="btn btn-success shadow ms-2">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="me-1" viewBox="0 0 16 16">
      <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
      <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
    </svg>
    تحميل الصور
  </a>
  <a href="/reports/cabinet" class="btn btn-outline-secondary ms-2">العودة</a>
</div>

<div class="report-header d-flex justify-content-between align-items-start flex-wrap gap-2">
  <div>
    <h4 class="fw-bold mb-1">تقرير كابينة مجمع — كابينة <span class="n"><%= cabinet.number %></span></h4>
    <div class="text-muted">السنترال: <strong><%= cabinet.exchange_name %></strong></div>
  </div>
  <div class="text-end">
    <div class="badge bg-primary fs-6"><%= boxData.length %> بوكس مفحوص</div>
    <div class="text-muted small mt-1">تاريخ الطباعة: <%= new Date().toLocaleDateString('ar-EG') %></div>
  </div>
</div>

<% boxData.forEach(function(d, idx) { %>
<div class="box-section">
  <div class="box-section-header d-flex justify-content-between align-items-center">
    <span><%= idx + 1 %>. بوكس <strong><%= d.box.number %></strong></span>
    <%
      const statusLabels = { pending_inspection:'بانتظار الفحص', inspected:'تم الفحص', needs_maintenance:'يحتاج صيانة', in_progress:'قيد الصيانة', completed:'مكتمل' };
      const statusColors = { pending_inspection:'secondary', inspected:'info', needs_maintenance:'warning', in_progress:'warning', completed:'success' };
    %>
    <span class="badge bg-<%= statusColors[d.box.status] || 'secondary' %>"><%= statusLabels[d.box.status] || d.box.status %></span>
  </div>
  <div class="p-2">

    <!-- Inspection info -->
    <div class="section-title">معلومات الفحص</div>
    <table class="table table-sm table-bordered mb-0">
      <tr>
        <th width="25%">المراقب</th><td><%= d.inspection.inspector_name %></td>
        <th width="20%">التاريخ</th><td><%= new Date(d.inspection.date).toISOString().split('T')[0] %></td>
      </tr>
      <% if (d.inspection.general_notes) { %>
      <tr><th>ملاحظات</th><td colspan="3"><%= d.inspection.general_notes %></td></tr>
      <% } %>
    </table>

    <!-- Checklist -->
    <div class="section-title">نتائج قائمة الفحص</div>
    <table class="table table-sm table-bordered mb-0">
      <thead class="table-light"><tr><th>البند</th><th>الحالة</th><th>الإصلاح</th><th>ملاحظات</th></tr></thead>
      <tbody>
      <% Object.entries(CHECKLIST_LABELS).forEach(function(entry) {
          var key = entry[0], label = entry[1];
          var item = d.items.find(function(i){ return i.item_key === key; });
          if (!item) return;
          var isBad = item.value === 'bad' || item.value === 'yes';
          var fixSt = d.itemStatusMap[key];
          var isDone = fixSt && fixSt.is_done;
      %>
      <tr class="<%= isDone ? 'table-success' : (isBad ? 'table-danger' : '') %>">
        <td><strong><%= label %></strong></td>
        <td><% if (item.value==='good') { %>جيد<% } else if (item.value==='bad') { %>سيء<% } else if (item.value==='yes') { %>يوجد<% } else { %>لا يوجد<% } %></td>
        <td><% if (isBad) { %><%= isDone ? '✓ تم الإصلاح' : '⏳ قيد الصيانة' %><% } else { %>—<% } %></td>
        <td class="text-muted"><%= item.notes || '—' %></td>
      </tr>
      <% }); %>
      </tbody>
    </table>

    <!-- Maintenance task -->
    <% if (d.task) { %>
    <div class="section-title">معلومات الصيانة</div>
    <table class="table table-sm table-bordered mb-0">
      <tr>
        <th width="25%">الفني</th><td><%= d.task.tech_name || '—' %></td>
        <th width="25%">حالة المهمة</th>
        <td><%= d.task.status === 'completed' ? 'مكتملة' : d.task.status === 'in_progress' ? 'قيد التنفيذ' : 'بانتظار البدء' %></td>
      </tr>
      <% if (d.task.notes) { %><tr><th>ملاحظات الفني</th><td colspan="3"><%= d.task.notes %></td></tr><% } %>
    </table>
    <% } %>

    <!-- Before Photos -->
    <% if (d.beforePhotos.length) { %>
    <div class="section-title">صور قبل الصيانة (<%= d.beforePhotos.length %>)</div>
    <div class="photo-grid">
      <% d.beforePhotos.forEach(function(p){ %><div class="photo-item"><img src="/uploads/<%= p.filename %>" alt="قبل"></div><% }); %>
    </div>
    <% } %>

    <!-- After Photos -->
    <% if (d.afterPhotos.length) { %>
    <div class="section-title">صور بعد الصيانة (<%= d.afterPhotos.length %>)</div>
    <div class="photo-grid">
      <% d.afterPhotos.forEach(function(p){ %><div class="photo-item"><img src="/uploads/<%= p.filename %>" alt="بعد"></div><% }); %>
    </div>
    <% } %>

  </div>
</div>
<% }); %>

<div class="text-center text-muted small mt-4 no-print">
  نظام صيانة البوكسات الذكي — Smart Box Maintenance System
</div>
</body>
</html>
