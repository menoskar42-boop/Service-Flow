<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h4 class="mb-0"><i class="bi bi-link-45deg me-2 text-info"></i><%= title %></h4>
  <a href="/reports" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-right"></i> التقارير</a>
</div>

<% if (typeof error !== 'undefined' && error) { %>
<div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i>تعذّر الاتصال بـ service-flow: <code><%= error %></code></div>
<% } %>

<!-- Filters -->
<form method="get" class="card card-body mb-3 py-2">
  <div class="row g-2 align-items-end">
    <div class="col-md-4">
      <input type="text" name="q" class="form-control form-control-sm" placeholder="بحث: سنترال، كابينة، بوكس" value="<%= query.q||'' %>">
    </div>
    <div class="col-md-3">
      <input type="text" name="exchange" class="form-control form-control-sm" placeholder="تصفية بالسنترال" value="<%= query.exchange||'' %>">
    </div>
    <div class="col-md-3">
      <button class="btn btn-primary btn-sm me-1"><i class="bi bi-search"></i> بحث</button>
      <a href="/reports/service-flow" class="btn btn-outline-secondary btn-sm">إعادة</a>
    </div>
    <div class="col-md-2 text-muted small pt-2">
      إجمالي: <strong><%= total %></strong> بوكس
      <% if (rows.length !== total) { %> | معروض: <strong><%= rows.length %></strong><% } %>
    </div>
  </div>
</form>

<% if (!rows.length && !(typeof error !== 'undefined' && error)) { %>
<div class="alert alert-info"><i class="bi bi-info-circle me-1"></i>لا توجد نتائج.</div>
<% } else if (rows.length) { %>

<%
// Group by central
const byCentral = {};
rows.forEach(r => {
  if (!byCentral[r.central]) byCentral[r.central] = [];
  byCentral[r.central].push(r);
});
%>

<% Object.entries(byCentral).forEach(([central, cRows]) => {
  const totalCount = cRows.reduce((s, r) => s + (parseInt(r.count)||0), 0);
%>
<div class="card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center py-2" style="background:#e8f4f8;border-right:4px solid #0dcaf0">
    <span class="fw-bold"><i class="bi bi-building me-1 text-info"></i>سنترال: <%= central %></span>
    <span class="badge bg-info text-dark">إجمالي الطلبات: <%= totalCount %></span>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-bordered table-sm table-hover mb-0 text-center">
        <thead class="table-dark">
          <tr>
            <th>#</th>
            <th>الكابينة</th>
            <th>البوكس</th>
            <th>عدد الطلبات المتعذرة</th>
          </tr>
        </thead>
        <tbody>
          <% cRows.forEach((row, idx) => { %>
          <tr>
            <td class="text-muted small"><%= idx + 1 %></td>
            <td><span class="n"><%= row.cabinNumber %></span></td>
            <td><strong><%= row.boxNumber %></strong></td>
            <td>
              <span class="badge <%= parseInt(row.count) >= 5 ? 'bg-danger' : parseInt(row.count) >= 3 ? 'bg-warning text-dark' : 'bg-secondary' %> fs-6">
                <%= row.count %>
              </span>
            </td>
          </tr>
          <% }) %>
        </tbody>
        <tfoot class="table-light fw-bold">
          <tr>
            <td colspan="3" class="text-end">إجمالي سنترال <%= central %></td>
            <td><span class="badge bg-info text-dark fs-6"><%= totalCount %></span></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>
<% }) %>

<% if (Object.keys(byCentral).length > 1) { %>
<div class="card border-primary">
  <div class="card-body py-2">
    <div class="row text-center">
      <div class="col-md-4">
        <div class="text-muted small">إجمالي البوكسات</div>
        <div class="fs-4 fw-bold text-primary"><%= rows.length %></div>
      </div>
      <div class="col-md-4">
        <div class="text-muted small">إجمالي الطلبات المتعذرة</div>
        <div class="fs-4 fw-bold text-danger"><%= rows.reduce((s,r) => s+(parseInt(r.count)||0), 0) %></div>
      </div>
      <div class="col-md-4">
        <div class="text-muted small">عدد السنترالات</div>
        <div class="fs-4 fw-bold text-info"><%= Object.keys(byCentral).length %></div>
      </div>
    </div>
  </div>
</div>
<% } %>

<% } %>
<%- include('../partials/footer') %>
