<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0 fw-bold"><i class="bi bi-clipboard-data me-1"></i><%= title %></h5>
  <span class="badge bg-info text-dark"><%= rows.length %> بوكس</span>
</div>

<p class="text-muted small">
  دى البكسيات اللى اترد عليها <strong>«بوكس مليان»</strong> ومطلوب مراجعة أرقامها.
  <% if (seesAll) { %>بتظهر لك <strong>كل البكسيات</strong>.
  <% } else { %>بتظهر لك <strong>كباينك انت بس</strong>.<% } %>
  الشاشة دى <strong>مخصوصة لمراجعة الأرقام</strong> — ملهاش علاقة بمهام الصيانة.
</p>

<% if (!rows.length) { %>
<div class="text-center text-muted py-5">
  <i class="bi bi-check2-circle fs-1 d-block mb-2 text-success opacity-75"></i>
  مفيش بكسيات مطلوب مراجعة بياناتها دلوقتى.
</div>
<% } else { %>
<div class="list-group">
  <% rows.forEach(r => { %>
  <a href="/data-review/<%= r.task_id %>" class="list-group-item list-group-item-action py-3">
    <div class="d-flex justify-content-between align-items-start gap-2">
      <div class="flex-fill min-w-0">
        <div class="fw-semibold mb-1">
          <i class="bi bi-box2 text-primary me-1"></i>بوكس <bdi dir="ltr"><strong><%= r.box_number %></strong></bdi>
        </div>
        <div class="small text-muted text-truncate">
          <i class="bi bi-building me-1"></i><%= r.exchange_name %>
          &nbsp;·&nbsp; كابينة <bdi dir="ltr"><%= r.cabinet_number %></bdi>
        </div>
        <div class="small text-info mt-1">
          <i class="bi bi-telephone me-1"></i><%= r.phones_count %> رقم على البكس
          <% if (r.opened_by_name) { %>&nbsp;·&nbsp;فتحها: <%= r.opened_by_name %><% } %>
        </div>
      </div>
      <span class="badge bg-info text-dark flex-shrink-0">محتاج مراجعة</span>
    </div>
  </a>
  <% }) %>
</div>
<% } %>
<%- include('../partials/footer') %>
