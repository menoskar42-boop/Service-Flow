<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0 fw-bold">
    <i class="bi bi-clipboard-data me-1"></i>مراجعة بيانات — بوكس <bdi dir="ltr"><%= task.box_number %></bdi>
  </h5>
  <a href="/data-review" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-right"></i> القائمة</a>
</div>

<div class="card mb-3">
  <div class="card-body py-2 small text-muted">
    <i class="bi bi-building me-1"></i><%= task.exchange_name %>
    &nbsp;·&nbsp; كابينة <bdi dir="ltr"><%= task.cabinet_number %></bdi>
    <% if (task.general_notes) { %><div class="mt-1"><%= task.general_notes %></div><% } %>
  </div>
</div>

<div class="card mb-3">
  <div class="card-header py-2 fw-semibold">
    <i class="bi bi-telephone me-1"></i>أرقام التليفونات على البكس
    <span class="badge bg-secondary"><%= phones.length %> رقم</span>
  </div>
  <div class="card-body">
    <p class="small text-muted">
      دى الأرقام اللى على البكس زى ما هى مسجّلة عندنا. راجعها: امسح الغلط، عدّل الناقص،
      وضيف اللى مش موجود. لما تخلّص اضغط <strong>«تمت المراجعة»</strong> تحت.
    </p>

    <% if (phones.length) { %>
    <div class="table-responsive box-phones-wrap">
      <table class="table table-sm align-middle box-phones-table">
        <thead class="table-light">
          <tr><th>#</th><th>رقم التليفون</th><th>ملاحظات</th><th>المصدر</th><th>إجراء</th></tr>
        </thead>
        <tbody>
          <% phones.forEach((p, idx) => { %>
          <tr>
            <td class="text-muted"><%= idx + 1 %></td>
            <form method="post" action="/data-review/<%= task.task_id %>/phones/<%= p.id %>">
              <td><input name="phone" value="<%= p.phone %>" class="form-control form-control-sm box-phone-input" dir="ltr"></td>
              <td><input name="notes" value="<%= p.notes || '' %>" class="form-control form-control-sm box-notes-input"></td>
              <td><span class="badge bg-light text-dark"><%= p.source === 'technician' ? 'الفنى' : 'من الموقع' %></span></td>
              <td class="d-flex gap-1">
                <button class="btn btn-outline-primary btn-sm"><i class="bi bi-save"></i> حفظ</button>
            </form>
                <form method="post" action="/data-review/<%= task.task_id %>/phones/<%= p.id %>/delete"
                      onsubmit="return confirm('حذف الرقم <%= p.phone %>؟');">
                  <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> حذف</button>
                </form>
              </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="text-muted small mb-3">مفيش أرقام مسجّلة على البكس ده — ضيفها من تحت.</div>
    <% } %>

    <form method="post" action="/data-review/<%= task.task_id %>/phones" class="row g-2 align-items-end">
      <div class="col-12 col-md-4">
        <label class="form-label small mb-1">إضافة رقم</label>
        <input name="phone" class="form-control form-control-sm box-phone-input" dir="ltr" placeholder="882650000" required>
      </div>
      <div class="col-12 col-md-4">
        <label class="form-label small mb-1">ملاحظات</label>
        <input name="notes" class="form-control form-control-sm box-notes-input" placeholder="ترمنال 3 (اختيارى)">
      </div>
      <div class="col-12 col-md-auto">
        <button class="btn btn-success btn-sm"><i class="bi bi-plus-lg"></i> إضافة</button>
      </div>
    </form>
  </div>
</div>

<% if (isDone) { %>
<div class="alert alert-success"><i class="bi bi-check2-circle me-1"></i>تمت مراجعة البكس ده بالفعل.</div>
<% } else { %>
<form method="post" action="/data-review/<%= task.task_id %>/done"
      onsubmit="return confirm('تأكيد إن أرقام البكس اتراجعت وخلصت؟');">
  <button class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i> تمت المراجعة</button>
</form>
<% } %>
<%- include('../partials/footer') %>
